# -----------------------------------------------------------------------------
# Firebase configuration — copy this file to `.env.local` and fill in real values
# -----------------------------------------------------------------------------
# NEVER commit `.env.local` (it's gitignored). Only this `.example` is tracked.
# Two separate credential sets live here:
#   1. Web app config (NEXT_PUBLIC_*)  — client SDK, used ONLY on the admin login
#      page to sign in. These are public by design (safe to ship to the browser).
#   2. Service account (FIREBASE_ADMIN_*) — server SDK (firebase-admin). SECRET.
#      Used for every Firestore/Storage read on the server. Never exposed to the
#      client; no NEXT_PUBLIC_ prefix, so Next.js keeps them server-only.
# -----------------------------------------------------------------------------

# --- 1. Firebase Web App config (client SDK — admin login page only) ----------
# From Firebase console → Project settings → General → "Your apps" → Web app.
NEXT_PUBLIC_FIREBASE_API_KEY=your-web-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-app-id

# --- 2. Service account (server SDK — firebase-admin) -------------------------
# From Firebase console → Project settings → Service accounts →
# "Generate new private key" (downloads a JSON). Copy the three fields below.
FIREBASE_ADMIN_PROJECT_ID=your-project-id
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
# IMPORTANT: the private key contains newlines. Paste it as a SINGLE line with
# the newlines written literally as \n, wrapped in double quotes exactly like the
# JSON gives it. The code un-escapes \n back into real newlines at runtime.
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEv...your...key...here...\n-----END PRIVATE KEY-----\n"

# --- 3. Cloudinary (admin image uploads) -------------------------------------
# Admin-uploaded images go to Cloudinary (free, no credit card). From your
# Cloudinary dashboard: the cloud name, plus an UNSIGNED upload preset you create
# under Settings -> Upload -> Upload presets (Signing Mode: Unsigned). Public by
# design (used in the browser), so NEXT_PUBLIC_.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=your-unsigned-preset
